# URL base de la API (se usa cuando VITE_AUTH_MODE=api)
VITE_API_URL=http://localhost:8000/api/v1

# demo = login de prueba sin backend | api = endpoints reales
VITE_AUTH_MODE=demo

# Opcional: ruta de Laravel para la tasa del día (relativa a VITE_API_URL).
# Si se deja vacío, se consulta directamente la API pública del BCV.
# VITE_EXCHANGE_RATE_API_URL=/billing/exchange-rate
